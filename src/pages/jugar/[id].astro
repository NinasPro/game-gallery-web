---
import { withBase } from '../../lib/url';
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const { title, authors, semester, description, controls, gameUrl, width, height } = game.data;
const sede = await getEntry(game.data.sede);
const fileName = `${game.id.replace(/-/g, '_')}.py`;
---

<Layout title={`${title} - Niñas Pro`}>
  <main class="relative overflow-hidden px-5 py-12 sm:px-8 sm:py-16">
    <div class="np-grid-bg pointer-events-none absolute inset-0 opacity-5" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-4xl">
      <a href={withBase('/')} class="font-mono text-sm font-bold uppercase tracking-wide text-np-ink/70 hover:text-np-blue">
        ← Volver al catálogo
      </a>

      <header class="mt-6 mb-8 text-center">
        <div class="flex flex-wrap justify-center gap-2">
          <a href={withBase(`/#sede-${sede.id}`)} class="np-chip bg-np-pink hover:bg-np-white">Sede {sede.data.nombre}</a>
          <span class="np-chip bg-np-yellow">Semestre {semester}</span>
        </div>
        <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl">
          {title}
        </h1>
        <p class="mt-3 font-mono text-xs uppercase tracking-wider text-np-gray">
          Desarrollado por: <strong class="text-np-ink">{authors}</strong>
        </p>
      </header>

      <div class="flex flex-col items-center">
        <div class="max-w-full overflow-x-auto border-2 border-np-ink bg-np-white shadow-hard-lg">
          <div class="np-titlebar">
            <span class="truncate">{fileName}</span>
            <span class="ml-3 flex shrink-0 gap-1" aria-hidden="true">
              <span class="np-winbtn">_</span><span class="np-winbtn">□</span><span class="np-winbtn">✕</span>
            </span>
          </div>
          <iframe
            src={withBase(gameUrl)}
            width={width}
            height={height}
            class="block border-0 bg-black"
            allow="autoplay; fullscreen"
          ></iframe>
        </div>
        <p class="mt-6 font-mono text-xs text-np-gray">
          &gt; Haz clic dentro del juego para activar el teclado (<strong class="text-np-ink">{controls}</strong>)
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-2xl border-2 border-np-ink bg-np-pink p-5 shadow-hard-sm">
        <p class="mb-2 font-mono text-xs font-bold uppercase tracking-widest text-np-ink/70">[ Sobre el juego ]</p>
        <p class="text-sm leading-relaxed sm:text-base">{description}</p>
      </div>
    </div>
  </main>
</Layout>
